# Database (Prisma)
DATABASE_URL="file:./dev.db"

# Google Gemini API (Required for EMBEDDINGS ONLY — vector retrieval from Pinecone)
GOOGLE_API_KEY="your_google_api_key_here"

# Groq API (Required for LLM chat — fast, free at console.groq.com)
GROQ_API_KEY="your_groq_api_key_here"
# Optional: defaults to openai/gpt-oss-120b
GROQ_MODEL="openai/gpt-oss-120b"
# Optional: small model for the query-rewrite/HyDE step (default openai/gpt-oss-20b)
# GROQ_HYDE_MODEL="openai/gpt-oss-20b"

# Pinecone Vector DB (Required for RAG)
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX="askqanoon"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_random_secret"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
